---
import Layout from '../../../layouts/Layout.astro';
import Closing from '../../../components/Closing.astro';
import { projects } from '../../../data/projects';
import { locales } from '../../../data/profile';
import { getLocale, translations } from '../../../i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}
const { project } = Astro.props;
const locale = getLocale(Astro.params.lang);
const t = translations[locale];
const copy = project.copy[locale];
const sections = copy.sections.map((body, i) => ({
  body,
  label: t.caseSections[project.sectionOrder?.[i] ?? i],
}));
const next =
  projects[
    (projects.findIndex((item) => item.slug === project.slug) + 1) %
      projects.length
  ];
---

<Layout
  title={`${copy.title} | Jair Ribeiro`}
  description={copy.summary}
  article
>
  <article class="container case-study">
    <header class="page-intro">
      <a class="breadcrumb" href={`/${locale}/cases/`}>← {t.back}</a><p
        class="eyebrow"
      >
        {copy.category}
        <span>/ {project.number}</span>
      </p><h1>{copy.title}</h1><p class="page-lead">{copy.summary}</p><div
        class="case-outcome"
      >
        <span aria-hidden="true">↗</span>{copy.outcome}
      </div>{
        project.inProgress && (
          <aside class="progress-notice">
            <>
              <strong>{t.progress}</strong>
              <p>{t.progressNote}</p>
            </>
          </aside>
        )
      }
    </header>
    <div class="article-layout">
      <aside class="article-index">
        <p class="eyebrow">
          {locale === 'pt' ? 'NESTE CASE' : 'IN THIS CASE'}
        </p><nav
          aria-label={locale === 'pt'
            ? 'Seções do case'
            : 'Case study sections'}
        >
          {
            sections.map(({ label }, i) => (
              <a href={`#section-${i}`}>
                {`0${i + 1}`}
                <span>{label}</span>
              </a>
            ))
          }
        </nav><div class="article-tech">
          <p class="eyebrow">{t.technologies}</p><p>
            {project.tags.join(' · ')}
          </p>
        </div>
      </aside><div class="prose article-body">
        {
          sections.map(({ body, label }, i) => (
            <section id={`section-${i}`}>
              <>
                <span class="eyebrow">0{i + 1}</span>
                <h2>{label}</h2>
                <p>{body}</p>
              </>
            </section>
          ))
        }
      </div>
    </div>
    <a class="next-case" href={`/${locale}/projetos/${next.slug}/`}
      ><span class="eyebrow">{t.more}</span><span
        >{next.copy[locale].title}</span
      ><span aria-hidden="true">↗</span></a
    >
  </article><Closing locale={locale} />
</Layout>
