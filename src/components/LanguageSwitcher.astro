---
import { getLocale } from '../i18n';
const locale = getLocale(Astro.currentLocale);
const rest = Astro.url.pathname.startsWith('/404')
  ? '/'
  : Astro.url.pathname.replace(/^\/(pt|en)/, '') || '/';
---

<nav class="language" aria-label={locale === 'pt' ? 'Idioma' : 'Language'}>
  <a
    href={`/pt${rest}`}
    lang="pt-BR"
    hreflang="pt-BR"
    aria-label="Português"
    aria-current={locale === 'pt' ? 'page' : undefined}>PT</a
  >
  <span aria-hidden="true">/</span>
  <a
    href={`/en${rest}`}
    lang="en"
    hreflang="en"
    aria-label="English"
    aria-current={locale === 'en' ? 'page' : undefined}>EN</a
  >
</nav>
