---
import en from '../i18n/en.js';
import pt from '../i18n/pt.js';
import StackIcon from './StackIcon.astro';
import SectionBackdrop from './SectionBackdrop.astro';

const t = Astro.currentLocale === 'en' ? en : pt;

const stages = [
  {
    key: 'ingest',
    title: t.stack.stages.ingest,
    items: ['Datastream', 'MySQL', 'API'],
  },
  {
    key: 'transform',
    title: t.stack.stages.transform,
    items: ['BigQuery', 'Dataform', 'dbt', 'SQL', 'Python'],
  },
  {
    key: 'orchestrate',
    title: t.stack.stages.orchestrate,
    items: ['Airflow', 'GKE', 'GCP', 'Git'],
  },
  {
    key: 'serve',
    title: t.stack.stages.serve,
    items: ['Streamlit'],
  },
];
---

<SectionBackdrop variant="solid" id="stack">
  <div class="max-w-5xl mx-auto px-4 py-28">
    <div class="reveal text-center mb-14">
      <h3 class="text-3xl md:text-4xl font-bold text-white mb-3">{t.stack.title}</h3>
      <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
        {t.stack.subtitle}
      </p>
    </div>

    <div class="reveal flex flex-col gap-5">
      {
        stages.map((stage, index) => (
          <div class="relative">
            {index > 0 && (
              <div
                class="hidden md:block absolute -top-5 left-1/2 -translate-x-1/2 w-px h-5 bg-white/10"
                aria-hidden="true"
              />
            )}
            <div class="de-panel rounded-xl p-5 md:p-6 bg-slate-950/60">
              <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
                <div class="md:w-40 shrink-0">
                  <p class="font-mono text-[10px] text-slate-500 tracking-widest uppercase mb-1">
                    stage_{index + 1}
                  </p>
                  <h4 class="text-lg font-semibold text-white">
                    {stage.title}
                  </h4>
                </div>
                <div class="flex flex-wrap gap-5 md:gap-6">
                  {stage.items.map((name) => (
                    <StackIcon name={name} />
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</SectionBackdrop>
