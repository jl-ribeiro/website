---
import pt from '../i18n/pt.js';
import en from '../i18n/en.js';
import SectionBackdrop from './SectionBackdrop.astro';

const t = Astro.currentLocale === 'en' ? en : pt;
---

<SectionBackdrop variant="solid" id="contato">
  <div class="max-w-3xl mx-auto px-4 py-32 md:py-40 text-center">
    <div class="reveal de-panel rounded-xl px-6 py-14 bg-slate-950/70">
      <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {t.contato.title}
      </h3>
      <p class="text-lg mb-10 text-slate-400 leading-relaxed max-w-xl mx-auto">
        {t.contato.paragraph}
      </p>
      <a
        href={`mailto:${t.contato.email}`}
        class="inline-block bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold py-3 px-6 rounded-lg transition-colors"
      >
        {t.contato.email}
      </a>
      <div class="mt-10 flex justify-center gap-8 text-sm">
        <a
          href="https://linkedin.com/in/jlribeiro"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-cyan-300 transition-colors"
          >LinkedIn</a
        >
        <a
          href="https://github.com/jl-ribeiro"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-cyan-300 transition-colors"
          >GitHub</a
        >
      </div>
    </div>
  </div>
</SectionBackdrop>
