---
/**
 * Interactive constellation / lineage network — hero only.
 * Nodes drift, edges form by proximity, cursor strengthens nearby links.
 */
---

<div
  class="hero-net absolute inset-0 -z-10 overflow-hidden"
  data-hero-net
  aria-hidden="true"
>
  <canvas class="absolute inset-0 h-full w-full" data-hero-net-canvas></canvas>
  <!-- Soft fade so copy stays readable -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-950/55 to-slate-950/25 md:via-slate-950/50 md:to-transparent"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-slate-950/40 via-transparent to-slate-950/50"
  ></div>
</div>

<script>
  type NetNode = { x: number; y: number; vx: number; vy: number; r: number };

  function initHeroNet(root: Element) {
    const found = root.querySelector('[data-hero-net-canvas]');
    if (!(found instanceof HTMLCanvasElement)) return;
    const canvas: HTMLCanvasElement = found;

    const maybeCtx = canvas.getContext('2d');
    if (!maybeCtx) return;
    const ctx: CanvasRenderingContext2D = maybeCtx;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const host = root.closest('section') || root.parentElement;
    if (!(host instanceof HTMLElement)) return;
    const section: HTMLElement = host;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let raf = 0;
    let nodes: NetNode[] = [];
    const mouse: { x: number | null; y: number | null; active: boolean } = {
      x: null,
      y: null,
      active: false,
    };

    const LINK_DIST = 140;
    const MOUSE_DIST = 180;

    function resize() {
      const rect = section.getBoundingClientRect();
      width = Math.max(1, Math.floor(rect.width));
      height = Math.max(1, Math.floor(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(28, Math.min(55, Math.floor((width * height) / 18000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * (reduce ? 0 : 0.35),
        vy: (Math.random() - 0.5) * (reduce ? 0 : 0.35),
        r: 1.2 + Math.random() * 1.6,
      }));
    }

    function step() {
      ctx.clearRect(0, 0, width, height);

      // faint grid
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.06)';
      ctx.lineWidth = 1;
      const gap = 48;
      ctx.beginPath();
      for (let x = 0; x <= width; x += gap) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
      }
      for (let y = 0; y <= height; y += gap) {
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
      }
      ctx.stroke();

      for (const n of nodes) {
        if (!reduce) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > width) n.vx *= -1;
          if (n.y < 0 || n.y > height) n.vy *= -1;
          n.x = Math.max(0, Math.min(width, n.x));
          n.y = Math.max(0, Math.min(height, n.y));
        }

        if (mouse.active && mouse.x != null && mouse.y != null) {
          const dx = mouse.x - n.x;
          const dy = mouse.y - n.y;
          const dist = Math.hypot(dx, dy);
          if (dist < MOUSE_DIST && dist > 1 && !reduce) {
            n.vx += (dx / dist) * 0.02;
            n.vy += (dy / dist) * 0.02;
            const speed = Math.hypot(n.vx, n.vy);
            if (speed > 0.9) {
              n.vx = (n.vx / speed) * 0.9;
              n.vy = (n.vy / speed) * 0.9;
            }
          }
        }
      }

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist > LINK_DIST) continue;

          let alpha = (1 - dist / LINK_DIST) * 0.22;
          if (mouse.active && mouse.x != null && mouse.y != null) {
            const midX = (a.x + b.x) / 2;
            const midY = (a.y + b.y) / 2;
            const md = Math.hypot(mouse.x - midX, mouse.y - midY);
            if (md < MOUSE_DIST) {
              alpha = Math.min(0.7, alpha + (1 - md / MOUSE_DIST) * 0.45);
            }
          }

          ctx.strokeStyle = `rgba(34, 211, 238, ${alpha})`;
          ctx.lineWidth = alpha > 0.5 ? 1.4 : 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      if (mouse.active && mouse.x != null && mouse.y != null) {
        for (const n of nodes) {
          const dist = Math.hypot(mouse.x - n.x, mouse.y - n.y);
          if (dist > MOUSE_DIST) continue;
          const alpha = (1 - dist / MOUSE_DIST) * 0.5;
          ctx.strokeStyle = `rgba(94, 234, 212, ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(mouse.x, mouse.y);
          ctx.lineTo(n.x, n.y);
          ctx.stroke();
        }

        ctx.fillStyle = 'rgba(34, 211, 238, 0.35)';
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }

      for (const n of nodes) {
        ctx.fillStyle = 'rgba(34, 211, 238, 0.85)';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (!reduce) raf = requestAnimationFrame(step);
    }

    function onMove(e: PointerEvent) {
      const rect = section.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
      if (reduce) step();
    }

    function onLeave() {
      mouse.active = false;
      mouse.x = null;
      mouse.y = null;
      if (reduce) step();
    }

    resize();
    step();
    if (!reduce) raf = requestAnimationFrame(step);

    section.addEventListener('pointermove', onMove, { passive: true });
    section.addEventListener('pointerleave', onLeave);
    window.addEventListener('resize', resize);

    return () => {
      cancelAnimationFrame(raf);
      section.removeEventListener('pointermove', onMove);
      section.removeEventListener('pointerleave', onLeave);
      window.removeEventListener('resize', resize);
    };
  }

  document.querySelectorAll('[data-hero-net]').forEach((root) => {
    initHeroNet(root);
  });
</script>
