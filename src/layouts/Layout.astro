---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import pt from '../i18n/pt.js';
import en from '../i18n/en.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
}

const { title, description, image, ogType = 'website' } = Astro.props;

// Pega o idioma atual e a tradução correta
const t = Astro.currentLocale === 'pt' ? pt : en;

// Cria o prefixo de URL correto para os links de navegação
const basePath =
  Astro.currentLocale === 'en' ? '/' : `/${Astro.currentLocale}/`;

// URL absoluta para imagens (necessária para OG/Twitter)
const siteUrl = Astro.site?.toString() || '';
const ogImage = image ? new URL(image, Astro.site).href : `${siteUrl}favicon.svg`;

---

<!doctype html>
<html lang={Astro.currentLocale} class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- SEO & Social Media -->
    <meta name="description" content={description ?? t.hero.subtitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t.hero.subtitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? t.hero.subtitle} />
    <meta name="twitter:image" content={ogImage} />

    <GoogleAnalytics />
  </head>
  <body class="bg-slate-900 text-slate-300">
    <header
      class="fixed top-0 left-0 w-full z-50 bg-slate-900/80 backdrop-blur-sm"
    >
      <div class="max-w-5xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <a href={basePath} class="text-white font-bold text-lg"
            >Jair Ribeiro</a
          >

          <div class="flex items-center gap-8">
            <nav class="hidden md:flex gap-6 text-sm">
              <a
                href={`${basePath}#projetos`}
                class="hover:text-emerald-400 transition-colors"
                >{t.nav.projects}</a
              >
              <a
                href={`${basePath}#sobre`}
                class="hover:text-emerald-400 transition-colors"
                >{t.nav.about}</a
              >
              <a
                href="#contato"
                class="hover:text-emerald-400 transition-colors"
                >{t.nav.contact}</a
              >
            </nav>

            <LanguageSwitcher />
          </div>
        </div>
      </div>
    </header>
    <slot />
  </body>
</html>
