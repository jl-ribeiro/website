---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import pt from '../i18n/pt.js';
import en from '../i18n/en.js';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** Quiet reading surface — no decorative motion (case studies). */
  readingMode?: boolean;
}

const {
  title,
  description,
  image,
  ogType = 'website',
  readingMode = false,
} = Astro.props;

const locale = Astro.currentLocale === 'pt' ? 'pt' : 'en';
const t = locale === 'pt' ? pt : en;
const basePath = `/${locale}/`;

const siteUrl = Astro.site?.toString() || 'https://jairribeiro.dev';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL('/og-default.svg', Astro.site).href;

const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|pt)/, '') || '/';
const enAlternate = new URL(
  `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`,
  Astro.site,
).href;
const ptAlternate = new URL(
  `/pt${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`,
  Astro.site,
).href;

const metaDescription = description ?? t.seo.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jair Ribeiro',
  url: siteUrl,
  jobTitle: locale === 'pt' ? 'Engenheiro de Dados' : 'Data Engineer',
  email: t.contato.email,
  sameAs: [
    'https://linkedin.com/in/jlribeiro',
    'https://github.com/jl-ribeiro',
  ],
  knowsAbout: [
    'Google Cloud Platform',
    'BigQuery',
    'Dataform',
    'FinOps',
    'Apache Airflow',
    'Python',
  ],
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="pt" href={ptAlternate} />
    <link rel="alternate" hreflang="x-default" href={enAlternate} />

    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content="Jair Ribeiro" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'pt' ? 'en_US' : 'pt_BR'}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <GoogleAnalytics />
  </head>
  <body
    class:list={[
      'de-shell relative text-slate-300 antialiased font-sans',
      readingMode && 'de-shell--reading',
    ]}
  >
    <header
      class="fixed top-0 left-0 w-full z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur-md"
    >
      <div class="max-w-5xl mx-auto px-4">
        <div class="flex items-center justify-between h-14">
          <a
            href={basePath}
            class="text-white font-semibold text-base tracking-tight"
          >
            <span class="font-mono text-cyan-400">~/</span>jair-ribeiro
          </a>

          <div class="flex items-center gap-4 md:gap-8">
            <nav class="hidden md:flex gap-6 text-sm">
              <a
                href={`${basePath}#projetos`}
                class="text-slate-400 hover:text-cyan-300 transition-colors"
                >{t.nav.projects}</a
              >
              <a
                href={`${basePath}#experiencia`}
                class="text-slate-400 hover:text-cyan-300 transition-colors"
                >{t.nav.experience}</a
              >
              <a
                href={`${basePath}#sobre`}
                class="text-slate-400 hover:text-cyan-300 transition-colors"
                >{t.nav.about}</a
              >
              <a
                href={`${basePath}#contato`}
                class="text-slate-400 hover:text-cyan-300 transition-colors"
                >{t.nav.contact}</a
              >
            </nav>

            <div class="hidden md:block">
              <LanguageSwitcher />
            </div>

            <details class="relative md:hidden group">
              <summary
                class="list-none cursor-pointer select-none rounded border border-cyan-500/30 bg-slate-950/60 px-3 py-1.5 text-sm font-mono text-cyan-200 hover:border-cyan-400/50 transition-colors [&::-webkit-details-marker]:hidden"
                aria-label={t.nav.menu}
              >
                <span class="group-open:hidden">{t.nav.menu}</span>
                <span class="hidden group-open:inline">{t.nav.close}</span>
              </summary>
              <div
                class="absolute right-0 mt-3 w-56 rounded-lg border border-cyan-500/20 bg-slate-950/95 backdrop-blur-md shadow-2xl p-4 flex flex-col gap-4"
              >
                <nav class="flex flex-col gap-3 text-sm">
                  <a
                    href={`${basePath}#projetos`}
                    class="text-slate-200 hover:text-cyan-300 transition-colors"
                    >{t.nav.projects}</a
                  >
                  <a
                    href={`${basePath}#experiencia`}
                    class="text-slate-200 hover:text-cyan-300 transition-colors"
                    >{t.nav.experience}</a
                  >
                  <a
                    href={`${basePath}#sobre`}
                    class="text-slate-200 hover:text-cyan-300 transition-colors"
                    >{t.nav.about}</a
                  >
                  <a
                    href={`${basePath}#contato`}
                    class="text-slate-200 hover:text-cyan-300 transition-colors"
                    >{t.nav.contact}</a
                  >
                </nav>
                <div class="border-t border-cyan-500/15 pt-3">
                  <LanguageSwitcher />
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>
    <slot />

    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        if (reduce) {
          document.querySelectorAll('.reveal').forEach((el) => {
            el.classList.add('is-visible');
          });
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        document
          .querySelectorAll('.reveal')
          .forEach((el) => observer.observe(el));

        document.querySelectorAll('[data-graph-node]').forEach((node) => {
          const id = node.getAttribute('data-graph-node');
          node.addEventListener('mouseenter', () => {
            document
              .querySelectorAll(`[data-edge-a="${id}"], [data-edge-b="${id}"]`)
              .forEach((e) => e.classList.add('is-hot'));
            node.classList.add('is-hot');
          });
          node.addEventListener('mouseleave', () => {
            document
              .querySelectorAll(`[data-edge-a="${id}"], [data-edge-b="${id}"]`)
              .forEach((e) => e.classList.remove('is-hot'));
            node.classList.remove('is-hot');
          });
          node.addEventListener('focus', () => {
            document
              .querySelectorAll(`[data-edge-a="${id}"], [data-edge-b="${id}"]`)
              .forEach((e) => e.classList.add('is-hot'));
            node.classList.add('is-hot');
          });
          node.addEventListener('blur', () => {
            document
              .querySelectorAll(`[data-edge-a="${id}"], [data-edge-b="${id}"]`)
              .forEach((e) => e.classList.remove('is-hot'));
            node.classList.remove('is-hot');
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --de-bg: #020617;
    --de-panel: #0b1220;
    --de-line: #1e293b;
    --de-accent: #22d3ee;
    --de-accent-2: #5eead4;
    --de-muted: #94a3b8;
  }

  .de-shell {
    min-height: 100vh;
    background-color: var(--de-bg);
  }

  .de-shell--reading {
    background-color: #020617;
  }

  .de-shell--reading .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .de-panel {
    background: var(--de-panel);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .de-edge-pulse {
    stroke-dasharray: 4 6;
    animation: de-dash 4s linear infinite;
  }

  @keyframes de-dash {
    to {
      stroke-dashoffset: -40;
    }
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-scroll {
    animation: bob 2.4s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 6px);
    }
  }

  .graph-edge {
    stroke: rgba(34, 211, 238, 0.28);
    stroke-width: 1.5;
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }

  .graph-edge.is-hot {
    stroke: #22d3ee;
    stroke-width: 2.5;
  }

  .graph-node {
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .graph-node.is-hot {
    filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.7));
  }

  @media (prefers-reduced-motion: reduce) {
    .de-edge-pulse,
    .hero-scroll {
      animation: none;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
