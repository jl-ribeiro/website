---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { profile, pageIds } from '../data/profile';
import { getLocale, translations } from '../i18n';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}
const locale = getLocale(Astro.currentLocale);
const t = translations[locale];
const {
  title = `Jair Ribeiro | ${locale === 'pt' ? 'Engenharia de Dados, Processos e Negócio' : 'Data Engineering, Processes and Business'}`,
  description = t.description,
  article = false,
} = Astro.props;
const base = `/${locale}/`;
const canonical = new URL(
  Astro.url.pathname.startsWith('/404') ? '/404.html' : Astro.url.pathname,
  Astro.site,
).href;
const rest = Astro.url.pathname.startsWith('/404')
  ? '/'
  : Astro.url.pathname.replace(/^\/(en|pt)/, '') || '/';
const links = [
  { href: base, label: t.nav[0] },
  ...pageIds.map((id, i) => ({ href: `${base}${id}/`, label: t.nav[i + 1] })),
];
const structured = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: locale === 'pt' ? 'Engenheiro de Dados' : 'Data Engineer',
  email: profile.email,
  sameAs: [profile.linkedin, profile.github],
};
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="theme-color" content="#f6f5ef" /><meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="pt-BR"
      href={new URL(`/pt${rest}`, Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(`/en${rest}`, Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/pt${rest}`, Astro.site).href}
    />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta
      property="og:url"
      content={canonical}
    />
    <meta property="og:site_name" content={profile.name} /><meta
      property="og:locale"
      content={locale === 'pt' ? 'pt_BR' : 'en_US'}
    />
    <meta
      property="og:image"
      content={new URL('/og-default.png', Astro.site).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structured)}
    />
    <GoogleAnalytics />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a
          class="brand"
          href={base}
          aria-label={`${profile.name} — ${t.nav[0]}`}
          ><span class="brand-mark" aria-hidden="true">jr<span>.</span></span
          ><span
            >Jair Ribeiro<span class="brand-subtitle">DATA ENGINEER</span></span
          ></a
        >
        <nav
          class="desktop-nav"
          aria-label={locale === 'pt'
            ? 'Navegação principal'
            : 'Main navigation'}
        >
          {
            links.slice(1).map((link) => (
              <a
                href={link.href}
                aria-current={
                  Astro.url.pathname === link.href ? 'page' : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="header-tools">
          <LanguageSwitcher /><details class="mobile-nav">
            <summary>{t.menu}<span aria-hidden="true"> ＋</span></summary><nav
              aria-label={t.menu}
            >
              {
                links.map((link) => (
                  <a
                    href={link.href}
                    aria-current={
                      Astro.url.pathname === link.href ? 'page' : undefined
                    }
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer container">
      <div>
        <a class="footer-name" href={base}>Jair Ribeiro<span>.</span></a><p>
          {t.footer}
        </p>
      </div><div class="footer-links">
        <a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}
          >GitHub ↗</a
        ><a href={`mailto:${profile.email}`}>E-mail ↗</a>
      </div><p class="copyright">© {new Date().getFullYear()} Jair Ribeiro</p>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (
          menu &&
          event.target instanceof Node &&
          !menu.contains(event.target)
        )
          menu.open = false;
      });
    </script>
  </body>
</html>
